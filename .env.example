# Django Settings
SECRET_KEY=django-insecure-dev-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (Optional - leave empty to use console backend)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# AI API Keys (Optional - chatbot works without)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
AI_SERVICE=gemini

# Site URL
SITE_URL=http://localhost:8000
